#!/bin/sh
# Rescore before any commit that touches something scripts/score.py reads, and stage the result.
# The public build never rescores — it reads the committed _data/stats.yml — so this is what keeps
# the ratings on the site current.
#
#   enable (once per clone):  git config core.hooksPath .githooks
#   skip for one commit:      git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

watched='^(_papers/.*\.md|_data/.*\.yml|scripts/(score|journal)\.py)$'
git diff --cached --name-only | grep -v '^_data/stats\.yml$' | grep -qE "$watched" || exit 0

# score.py reads the working tree, not the index: unstaged edits to a review count too.
if ! python3 scripts/score.py >/dev/null; then
  echo "pre-commit: scripts/score.py failed — fix it, or commit with --no-verify" >&2
  exit 1
fi
git add _data/stats.yml tags/
echo "pre-commit: rescored, _data/stats.yml and tags/ staged"
